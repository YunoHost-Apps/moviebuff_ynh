[Unit]
Description=MovieBuff: reads from other servers
Documentation=https://codeberg.org/retiolus/moviebuff
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=__APP__
Group=__APP__
UMask=0027
WorkingDirectory=__INSTALL_DIR__/app/
# One read at a time: a slow server holds this queue, never the deliveries.
# The node name keeps two instances on one server apart
ExecStart=__INSTALL_DIR__/venv/bin/celery -A moviebuff worker -l info -Q peer-reads -n __APP__-peer-reads@%%h --concurrency 1 --prefetch-multiplier 1
Restart=on-failure
RestartSec=5

# Sandboxing options to harden security
# Details for these options: https://www.freedesktop.org/software/systemd/man/systemd.exec.html
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
DevicePolicy=closed
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
# The file cache holds the rate-limit counters and the external ratings
ReadWritePaths=__INSTALL_DIR__/cache
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation @privileged

CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
