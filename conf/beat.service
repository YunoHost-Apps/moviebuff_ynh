[Unit]
Description=MovieBuff: scheduled tasks
Documentation=https://codeberg.org/retiolus/moviebuff
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=__APP__
Group=__APP__
UMask=0027
WorkingDirectory=__INSTALL_DIR__/app/
# Exactly one beat per instance: two would tick the same schedule twice
ExecStart=__INSTALL_DIR__/venv/bin/celery -A moviebuff beat -l info -s __INSTALL_DIR__/beat/celerybeat-schedule
Restart=on-failure
RestartSec=5

# Sandboxing options to harden security
# Details for these options: https://www.freedesktop.org/software/systemd/man/systemd.exec.html
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
DevicePolicy=closed
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
# Where beat remembers when each task last ran
ReadWritePaths=__INSTALL_DIR__/beat
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation @privileged

CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
