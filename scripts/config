#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# SPECIFIC VALIDATORS FOR TOML SHORT KEYS
#=================================================

# django-environ reads a value starting with $ as the name of another variable
validate__email_password() {
    if [[ "$email_password" == \$* ]]; then
        echo "MovieBuff cannot read a password that starts with \$"
    fi
}

#=================================================
# GENERIC FINALIZATION
#=================================================

ynh_app_config_apply() {
    # The panel never shows a saved password or key, so an empty field means "unchanged"
    if [ "$email_mode" == custom ] && [ -z "${email_password:-}" ]; then
        email_password="${old[email_password]:-}"
    fi
    if [ -z "${tmdb_api_key:-}" ]; then
        tmdb_api_key="${old[tmdb_api_key]:-}"
    fi

    _ynh_app_config_apply

    # postfix and dovecot only let the app send from the address in their maps
    if [ "${changed[mail_user]:-false}" == true ] || [ "${changed[mail_domain]:-false}" == true ]; then
        ynh_hide_warnings yunohost tools regen-conf postfix dovecot
    fi

    _moviebuff_write_env
}

#=================================================
# ACTIONS
#=================================================

# Sent with the settings already saved, which the services read
run__send_test_email() {
    if [ "$email_mode" == none ]; then
        ynh_die "MovieBuff sends no e-mail: choose how it sends them, save, then try again."
    fi
    _moviebuff_manage sendtestemail "$test_address"
    ynh_print_info "Test e-mail sent to $test_address"
}

#=================================================
ynh_app_config_run "$1"
